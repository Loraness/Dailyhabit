{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dailyhabit",
  "version": "0.2.0",
  "identifier": "com.dailyhabit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dailyhabit",
        "width": 880,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQTQwNEI4NkRDQTQ5QTEKUldTaFNjcHR1QVNrL3paejhsOGNSNGdmU3lrMVV6ZjlGM044aCtxeCtyWWRabzMwZ0RHRG1tOUYK",
      "endpoints": [
        "https://raw.githubusercontent.com/Loraness/Dailyhabit/refs/heads/main/update.json"
      ]
    }
  }
}
